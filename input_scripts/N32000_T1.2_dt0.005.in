log /home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/sim.log

# Initialization
units lj
dimension 3
boundary p p p
atom_style atomic

# Create simulation box and atoms
lattice fcc 0.3 origin 0.05 0.05 0.05
region simbox block 0 20 0 20 0 20 units lattice
create_box 1 simbox
create_atoms 1 box
mass 1 1.0
velocity all create 1.2 94673 mom yes

# Potential settings
pair_style lj/smooth 2.5 3.5
pair_coeff 1 1 1.0 1.0
pair_modify shift yes

# Monitoring variables
variable time equal time
variable etot equal etotal
variable vol equal vol
variable dens equal density

# Default computes
compute temp all temp
compute press all pressure thermo_temp

# Born matrix computation
compute press_pot all pressure NULL virial
compute born_matrix all born/matrix numdiff 1e-06 press_pot
compute born_matrix_nl all born/matrix/nonlinear 1e-06 press_pot born_matrix

# Timestep (default 0.005 for lennard-jones)
timestep 0.005

# Screen and log output
thermo 10000
thermo_style custom step temp press etotal
thermo_modify flush yes

fix nvt_eq all nvt temp 1.2 1.2 0.5
run 10000
unfix nvt_eq

fix nve_prod all nve 
run 10000

# Output values
fix thermo_output all ave/time 1 1 4 v_time c_thermo_temp v_etot v_vol v_dens &
    file "/home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/thermo.dat"
fix press_output all ave/time 1 1 4 v_time c_press[*] &
    file "/home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/press.dat"
fix press_pot_output all ave/time 1 1 4 v_time c_press_pot[*] &
    file "/home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/press_pot.dat"
fix born_output all ave/time 1 1 4 v_time c_born_matrix[*] &
    file "/home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/born.dat"
fix born_nl_output all ave/time 1 1 4 v_time c_born_matrix_nl[*] &
    file "/home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/born_nl.dat"

fix nve_prod all nve 
run 100000

unfix born_nl_output

run 900000

write_restart "/home/fgarbuzov/Documents/lammps_test/data/convergence/N32000/T1.2/dt0.005/snapshot_1M.restart"

# Initialization
units lj
dimension 3
boundary p p p
atom_style atomic

# Create simulation box and atoms
lattice fcc 1.058 origin 0.05 0.05 0.05
region simbox block 0 10 0 10 0 10 units lattice
create_box 1 simbox
create_atoms 1 box
mass 1 1.0
velocity all create 4.0 94673 mom yes

# Potential settings
pair_style lj/smooth 2.5 3.5
pair_coeff 1 1 1.0 1.0
pair_modify shift yes

# Monitoring variables
variable time equal time
variable etot equal etotal
variable vol equal vol
variable dens equal density

# Default computes
compute temp all temp
compute press all pressure thermo_temp

# Timestep (default 0.005 for lennard-jones)
timestep 0.001

# Screen and log output
thermo 10000
thermo_style custom step temp press etotal
thermo_modify flush yes

fix nvt_eq all nvt temp 4.0 4.0 0.1
run 10000
unfix nvt_eq

# Output values
fix thermo_output all ave/time 1 1 1 v_time c_thermo_temp v_etot v_vol v_dens &
    file "/home/fgarbuzov/Documents/lammps_test/data/strains/N4000/T4.0_nve_nvt/vel_remap_dt0.001_eps0.001/thermo.dat"
fix press_output all ave/time 1 1 1 v_time c_press[*] &
    file "/home/fgarbuzov/Documents/lammps_test/data/strains/N4000/T4.0_nve_nvt/vel_remap_dt0.001_eps0.001/press.dat"

fix nve_prod all nve

variable Lx0 equal lx
run 0
variable Lx0_saved equal ${Lx0}
variable run_wait equal 500
variable run_eq equal 2000

variable xscale equal 1.001
variable xscale_inv equal 1.0/v_xscale

variable vy_keep atom vy
variable vz_keep atom vz
variable vx_contract atom v_xscale_inv*vx
variable vx_expand   atom v_xscale*vx

run ${run_wait}
unfix nve_prod

variable i loop 1000
label loop_start

fix nve_prod all nve
print "Cycle ${i}"
change_box all x scale ${xscale} remap
velocity all set v_vx_contract v_vy_keep v_vz_keep sum no
run ${run_wait}

change_box all x final 0 ${Lx0_saved} remap units box
velocity all set v_vx_expand v_vy_keep v_vz_keep sum no
run ${run_wait}
unfix nve_prod

fix nvt_prod all nvt temp 4.0 4.0 0.1
run ${run_eq}
unfix nvt_prod

next i
jump SELF loop_start

write_restart "/home/fgarbuzov/Documents/lammps_test/data/strains/N4000/T4.0_nve_nvt/vel_remap_dt0.001_eps0.001/snapshot_1k_loops.restart"
